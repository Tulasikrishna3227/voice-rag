# --- LLM (any OpenAI-compatible endpoint) ---
# DEFAULT: fully local with Ollama, NO API KEY. Install https://ollama.com then: ollama pull gemma3:4b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gemma3:4b
# (Docker: use LLM_BASE_URL=http://host.docker.internal:11434/v1)
#
# Hosted option (needs a free key), e.g. Groq -> https://console.groq.com
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter free models: LLM_BASE_URL=https://openrouter.ai/api/v1 and LLM_MODEL=<any model ending in :free>
# Free-tier limits and model names change; check the provider's page.

# --- Models (all run locally, free) ---
EMBED_MODEL=intfloat/multilingual-e5-small
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
WHISPER_MODEL=small
USE_RERANK=true

# --- RAG tuning ---
CHUNK_WORDS=200
CHUNK_OVERLAP=40
TOP_K_RETRIEVE=20
TOP_K_FINAL=4
